# Local Compose configuration only. Copy to .env and fill every blank secret.
# Generate independent values with: openssl rand -hex 32
POSTGRES_DB=payflow
POSTGRES_USER=payflow
POSTGRES_PASSWORD=
API_KEY_PEPPER=
PROVIDER_A_WEBHOOK_SECRET=
PROVIDER_B_WEBHOOK_SECRET=
GRAFANA_ADMIN_USER=payflow
GRAFANA_ADMIN_PASSWORD=
# Optional host port overrides (all bound to 127.0.0.1).
PAYFLOW_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
KAFKA_HOST_PORT=19092
TRACING_SAMPLING_PROBABILITY=0.1
FRONTEND_PORT=3001
